{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@universal-workspace/shared-types": ["packages/shared-types/src"],
      "@universal-workspace/module-sdk": ["packages/module-sdk/src"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["node_modules"]
}
